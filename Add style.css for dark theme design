/* ============================
   RESET & BASE
   ============================ */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background: #0a0a0a;
  color: #e0e0e0;
  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
}

/* ============================
   NAVIGATION
   ============================ */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.25rem 3rem;
  background: rgba(10, 10, 10, 0.95);
  backdrop-filter: blur(10px);
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1px solid #1a1a1a;
}

.nav-brand {
  font-size: 1.25rem;
  font-weight: 700;
  color: #fff;
}

.nav-links {
  display: flex;
  list-style: none;
  gap: 2rem;
}

.nav-links a {
  color: #aaa;
  font-size: 0.95rem;
  transition: color 0.2s;
}

.nav-links a:hover {
  color: #00d4aa;
}

.nav-cta {
  background: linear-gradient(135deg, #00d4aa, #00b894);
  color: #000 !important;
  padding: 0.6rem 1.25rem;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.9rem;
  transition: transform 0.2s, box-shadow 0.2s;
}

.nav-cta:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 15px rgba(0, 212, 170, 0.3);
}

/* ============================
   HERO SECTION
   ============================ */
.hero {
  text-align: center;
  padding: 5rem 2rem 3rem;
  max-width: 800px;
  margin: 0 auto;
}

.hero-badge {
  display: inline-block;
  background: rgba(0, 212, 170, 0.1);
  color: #00d4aa;
  padding: 0.4rem 1rem;
  border-radius: 20px;
  font-size: 0.85rem;
  font-weight: 500;
  margin-bottom: 1.5rem;
  border: 1px solid rgba(0, 212, 170, 0.2);
}

.hero h1 {
  font-size: 3rem;
  font-weight: 800;
  color: #fff;
  line-height: 1.2;
  margin-bottom: 1rem;
}

.hero p {
  font-size: 1.15rem;
  color: #888;
  max-width: 600px;
  margin: 0 auto 2rem;
  line-height: 1.7;
}

.hero-cta {
  display: inline-block;
  background: linear-gradient(135deg, #00d4aa, #00b894);
  color: #000;
  padding: 1rem 2.5rem;
  border-radius: 10px;
  font-weight: 600;
  font-size: 1rem;
  transition: transform 0.2s, box-shadow 0.2s;
}

.hero-cta:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0, 212, 170, 0.3);
}

/* ============================
   STATS SECTION
   ============================ */
.stats {
  display: flex;
  justify-content: center;
  gap: 4rem;
  padding: 3rem 2rem;
  border-top: 1px solid #1a1a1a;
  border-bottom: 1px solid #1a1a1a;
}

.stat-item {
  text-align: center;
}

.stat-number {
  display: block;
  font-size: 2.5rem;
  font-weight: 800;
  color: #00d4aa;
}

.stat-label {
  color: #666;
  font-size: 0.9rem;
}

/* ============================
   SECTIONS COMMON
   ============================ */
.section-title {
  text-align: center;
  font-size: 2.2rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 3rem;
}

/* ============================
   SERVICES SECTION
   ============================ */
.services {
  padding: 5rem 2rem;
  max-width: 1200px;
  margin: 0 auto;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.service-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid #1a1a1a;
  border-radius: 12px;
  padding: 2rem;
  transition: transform 0.2s, border-color 0.2s;
}

.service-card:hover {
  transform: translateY(-4px);
  border-color: #00d4aa;
}

.service-icon {
  font-size: 2rem;
  margin-bottom: 1rem;
}

.service-card h3 {
  color: #fff;
  font-size: 1.1rem;
  margin-bottom: 0.75rem;
}

.service-card p {
  color: #777;
  font-size: 0.9rem;
  line-height: 1.6;
}

/* ============================
   PROCESS SECTION
   ============================ */
.process {
  padding: 5rem 2rem;
  background: #0d0d0d;
  border-top: 1px solid #1a1a1a;
}

.process-steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
  max-width: 1100px;
  margin: 0 auto;
}

.step {
  text-align: center;
  padding: 1.5rem;
}

.step-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  background: linear-gradient(135deg, #00d4aa, #00b894);
  color: #000;
  font-weight: 700;
  font-size: 1.2rem;
  border-radius: 50%;
  margin-bottom: 1rem;
}

.step h3 {
  color: #fff;
  font-size: 1.1rem;
  margin-bottom: 0.75rem;
}

.step p {
  color: #777;
  font-size: 0.9rem;
  line-height: 1.6;
}

/* ============================
   PORTFOLIO SECTION
   ============================ */
.portfolio {
  padding: 5rem 2rem;
  max-width: 1200px;
  margin: 0 auto;
}

.portfolio-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.portfolio-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid #1a1a1a;
  border-radius: 12px;
  padding: 2rem;
  transition: transform 0.2s, border-color 0.2s;
}

.portfolio-card:hover {
  transform: translateY(-4px);
  border-color: #00d4aa;
}

.portfolio-card h3 {
  color: #fff;
  font-size: 1.1rem;
  margin-bottom: 0.75rem;
}

.portfolio-card p {
  color: #777;
  font-size: 0.9rem;
  line-height: 1.6;
  margin-bottom: 1rem;
}

.portfolio-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.portfolio-tags span {
  background: rgba(0, 212, 170, 0.1);
  color: #00d4aa;
  padding: 0.3rem 0.75rem;
  border-radius: 6px;
  font-size: 0.8rem;
  font-weight: 500;
}

/* ============================
   CONTACT SECTION - FORMSPREE
   ============================ */
.contact-section {
  padding: 5rem 2rem;
  background: linear-gradient(180deg, #0d0d0d 0%, #111 100%);
  border-top: 1px solid #1a1a1a;
}

.contact-section .container {
  max-width: 1100px;
  margin: 0 auto;
}

.contact-section .section-title {
  text-align: center;
  font-size: 2.2rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 0.75rem;
}

.contact-section .section-subtitle {
  text-align: center;
  color: #888;
  font-size: 1.05rem;
  max-width: 600px;
  margin: 0 auto 3rem;
  line-height: 1.6;
}

.contact-wrapper {
  display: grid;
  grid-template-columns: 1fr 1.3fr;
  gap: 3rem;
  align-items: start;
}

/* CTA Box */
.contact-cta {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid #1a1a1a;
  border-radius: 16px;
  padding: 2.5rem;
}

.contact-cta h3 {
  font-size: 1.4rem;
  color: #fff;
  margin-bottom: 1rem;
}

.contact-cta p {
  color: #888;
  line-height: 1.7;
  margin-bottom: 1.5rem;
  font-size: 0.95rem;
}

.trust-badges {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.trust-badges span {
  color: #666;
  font-size: 0.9rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

/* Form */
.contact-form {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid #1a1a1a;
  border-radius: 16px;
  padding: 2.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.form-group label {
  color: #bbb;
  font-size: 0.9rem;
  font-weight: 500;
}

.form-group input,
.form-group textarea {
  padding: 0.875rem 1rem;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid #2a2a2a;
  border-radius: 10px;
  color: #fff;
  font-size: 1rem;
  font-family: inherit;
  transition: all 0.2s ease;
}

.form-group input::placeholder,
.form-group textarea::placeholder {
  color: #555;
}

.form-group input:focus,
.form-group textarea:focus {
  outline: none;
  border-color: #00d4aa;
  box-shadow: 0 0 0 3px rgba(0, 212, 170, 0.1);
  background: rgba(255, 255, 255, 0.08);
}

.form-group textarea {
  resize: vertical;
  min-height: 100px;
}

/* Submit Button */
.submit-btn {
  padding: 1rem 2rem;
  background: linear-gradient(135deg, #00d4aa, #00b894);
  color: #000;
  border: none;
  border-radius: 10px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
  margin-top: 0.5rem;
}

.submit-btn span {
  font-size: 1rem;
}

.submit-btn small {
  font-size: 0.75rem;
  opacity: 0.8;
  font-weight: 400;
}

.submit-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0, 212, 170, 0.3);
}

.submit-btn:active {
  transform: translateY(0);
}

/* ============================
   FOOTER
   ============================ */
.footer {
  text-align: center;
  padding: 2rem;
  border-top: 1px solid #1a1a1a;
  color: #555;
  font-size: 0.9rem;
}

/* ============================
   RESPONSIVE
   ============================ */
@media (max-width: 968px) {
  .services-grid,
  .portfolio-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .process-steps {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .contact-wrapper {
    grid-template-columns: 1fr;
  }
  
  .hero h1 {
    font-size: 2.2rem;
  }
  
  .stats {
    gap: 2rem;
  }
}

@media (max-width: 600px) {
  .navbar {
    padding: 1rem 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  .nav-links {
    gap: 1rem;
    order: 3;
    width: 100%;
    justify-content: center;
  }
  
  .services-grid,
  .portfolio-grid,
  .process-steps {
    grid-template-columns: 1fr;
  }
  
  .hero h1 {
    font-size: 1.8rem;
  }
  
  .stats {
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .contact-section {
    padding: 3rem 1.5rem;
  }
  
  .contact-form,
  .contact-cta {
    padding: 1.5rem;
  }
}
